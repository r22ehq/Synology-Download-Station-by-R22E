
# Optional: Real NAS integration test credentials

# 1. Preflight (Read-Only)
# R22E_TEST_NAS_URL=https://your-nas:5001
# R22E_TEST_USERNAME=r22e_test
# R22E_TEST_PASSWORD=your-test-password
# R22E_TEST_DESTINATION=/r22e-test

# 2. Full Integration (Mutating/Destructive)
# R22E_TEST_ALLOW_MUTATIONS=YES

# Build mode
# R22E_E2E=1
